//first
class Solution {
    public int addDigits(int num) {
        if (num == 0) {
            return 0;
        }
        return 1 + ((num - 1) % 9);
    }
}
//second
class Solution {
    public int addDigits(int num) {
          int numOfDigits = String.valueOf(num).length();
           int sum = 0;

        while (num > 0) {
            int digit = num % 10;
            sum += digit;
            num /= 10;
        }
        if(String.valueOf(sum).length() > 1){
            return addDigits(sum);
        }
        return sum;
    }
}
