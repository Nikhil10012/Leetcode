class Solution {
    public int maxProfit(int[] prices) {
        int maxProfit = 0;
        int n = prices.length;
        
        int buy = 0; // Index of the potential buying day
        int sell = 0; // Index of the potential selling day
        
        while (sell < n) {
            if (prices[sell] < prices[buy]) {
                // Found a potential buying day with lower price
                buy = sell;
            } else {
                // Calculate potential profit and update maxProfit
                maxProfit = Math.max(maxProfit, prices[sell] - prices[buy]);
            }
            sell++;
        }

        return maxProfit;
    }
}
