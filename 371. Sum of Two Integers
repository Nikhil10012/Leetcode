public class Main {

    public static int getSum(int a, int b) {
        while (b != 0) {
            int carry = (a & b) << 1;
            a = a ^ b;
            b = carry;
        }
        return a;
    }

    public static void main(String[] args) {
        int result = getSum(5, 3);
        System.out.println(result); // Output: 8
    }
}
