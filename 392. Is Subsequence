class Solution {
    public boolean isSubsequence(String s, String t) {
        int s1 = s.length();
        int s2 = t.length();
        int i=0;
        int j=0;
       while (i < s1 && j < s2) {
            if (s.charAt(i) == t.charAt(j)) {
                i++;
            }
            j++;
        }
        
        if(i==s1){
            return true;
        }
        return false;
    }
}
