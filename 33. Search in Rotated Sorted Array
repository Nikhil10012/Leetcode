class Solution {
    public int search(int[] nums, int target) {
        int n = nums.length;
        int p=0;
        int flag = 0;
       for(int i=0;i<n;i++){
           if(nums[i]==target){
               p = i;
               flag=1;
               break;
           }
       }
       if(flag==1){return p;}
       else{return -1;}
    }
}
