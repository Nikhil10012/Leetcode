class Solution {
    public List<Integer> addToArrayForm(int[] num, int k) {
        int n = num.length;
        int carry = 0;
        List<Integer> result = new ArrayList<>();

        for (int i = n - 1; i >= 0 || k > 0; i--) {
            int x = i >= 0 ? num[i] : 0;
            int sum = x + k % 10 + carry;
            result.add(sum % 10);
            carry = sum / 10;
            k /= 10;
        }

        if (carry > 0) {
            result.add(carry);
        }

        Collections.reverse(result);

        return result;
    }
}
