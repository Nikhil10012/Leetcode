class Solution {
    public ListNode reverseBetween(ListNode h, int left, int right) {
        if (h == null || h.next == null)
            return h;

        ListNode dummy = new ListNode(0);
        dummy.next = h;
        ListNode prev = dummy;

        for (int i = 1; i < left; i++) {
            prev = prev.next;
        }

        ListNode start = prev.next;
        ListNode then = start.next;

        for (int i = 0; i < right - left; i++) {
            start.next = then.next;
            then.next = prev.next;
            prev.next = then;
            then = start.next;
        }

        return dummy.next;
    }
}
