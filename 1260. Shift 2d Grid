class Solution {
    public List<List<Integer>> shiftGrid(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;
        int[][] newM = new int[m][n];
        
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                int ni = (i + (j + k) / n) % m; // Calculate new row index
                int nj = (j + k) % n;           // Calculate new column index
                newM[ni][nj] = grid[i][j];
            }
        }
        
        List<List<Integer>> result = new ArrayList<>();
        for (int i = 0; i < m; i++) {
            List<Integer> row = new ArrayList<>();
            for (int j = 0; j < n; j++) {
                row.add(newM[i][j]);
            }
            result.add(row);
        }
        
        return result;
    }
}
