//1st Solution
class Solution {
    public boolean isHappy(int n) {
        if(n ==1){
            return true;
        }
         if (n == 4) {
            return false;  // If n reaches 4, it's in a cycle and not happy.
        }
        int re =0;
        int sum = 0;     
        while(n>0){
            re = n%10;
            sum = sum + re * re;
            n = n/10;
        }
       
        return isHappy(sum);
    }
}
// 2nd solution
class Solution {
    public boolean isHappy(int n) {
        int slow = n;
        int fast = n;
        
        do {
            slow = digitSquareSum(slow);
            fast = digitSquareSum(fast);
            fast = digitSquareSum(fast);
        } while (slow != fast);
        
        return slow == 1;
    }

    private int digitSquareSum(int n) {
        int sum = 0;
        while (n > 0) {
            int digit = n % 10;
            sum += digit * digit;
            n /= 10;
        }
        return sum;
    }
}
