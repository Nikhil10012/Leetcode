class Solution {
    public boolean isPalindrome(int x) {
      int sum =0;
      int r = 0;
      int  temp=x;    
  while(x>0){    
   r=x%10;  //getting remainder  
   sum=(sum*10)+r;    
   x=x/10;    
  }    
  if(temp==sum)    
   return true;   
  else    
   return false;    
    }
}
//second solution
class Solution {
    public boolean isPalindrome(int x) {
        if (x < 0 || (x % 10 == 0 && x != 0)) {
            return false;
        }
        
        int reversed = 0;
        
        while (x > reversed) {
            int digit = x % 10;
            reversed = reversed * 10 + digit;
            x /= 10;
        }
        
        return x == reversed || x == reversed / 10;
    }
}
