import java.util.*;
public class D6_SearchInsert {
        public static int searchInsert(int[] nums, int target) {
            int s = 0;
        int e = nums.length - 1;

        while (e >= s) {
            int mid = s + (e - s) / 2;
            if (nums[mid] == target) {
                return mid;
            }
            if (nums[mid] > target) {
                e = mid - 1;
            } else {
                s = mid + 1;
            }
        }
        return s;
        }
    public static void main(String[] args){
        int[] arr = {1,3,5,6};
        int res = searchInsert(arr,7);
        System.out.println(res);
    }
}

